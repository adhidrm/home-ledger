# Supabase project (publishable key aman di browser; RLS yang menjaga data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud OAuth client (Web). Publik, bukan rahasia. Origin: https://duit.proximalab.fyi
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# Hanya untuk `npm run db:push` / `db:test`. Rahasia: jangan beri awalan NEXT_PUBLIC_.
